{
  "name": "bloom-wellness",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-on-deploy.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:integration": "vitest run tests/integration",
    "db:up": "docker compose up -d --wait",
    "db:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "screenshots": "node scripts/screenshots.mts"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@tanstack/react-query": "^5.103.2",
    "zustand": "^5.0.15",
    "zod": "^4.6.5",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "prisma": "^7.0.0",
    "dotenv": "^18.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "vitest": "^5.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.1.1",
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
