# Copy to .env locally. Add the same variables in Vercel project settings.
DATABASE_URL="postgresql://bloom:bloom@localhost:5432/bloom"
# Direct connection for migrations (optional if DATABASE_URL is direct)
DIRECT_URL=""
# Separate database used by the integration tests (npm run test:integration).
TEST_DATABASE_URL="postgresql://bloom:bloom@localhost:5432/bloom_test"
APP_URL="http://localhost:3000"
# Generate separate random 32+ character secrets. Never prefix secrets NEXT_PUBLIC_.
ADMIN_TOKEN=""
CRON_SECRET=""
RATE_LIMIT_SECRET=""
RESEND_API_KEY=""
# Must use a verified domain in Resend.
RESEND_FROM="Bloom Wellness <hello@your-verified-domain.com>"
CLINIC_REPLY_TO=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OWNER_NUMBER=""
# Set a currently supported version in your Meta app, e.g. v23.0.
WHATSAPP_GRAPH_VERSION=""
WHATSAPP_TEMPLATE_NAME="bloom_new_inquiry"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
META_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
